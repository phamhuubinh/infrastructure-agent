FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    iproute2 \
    iputils-ping \
    openssh-client \
    procps \
    util-linux \
    wait-for-it \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .
RUN uv sync --frozen --no-dev --extra web --no-install-project

COPY src/ src/
COPY config/ config/
COPY tools.json .
RUN uv sync --frozen --no-dev --extra web

ENV HOME="/home/orion" PATH="/app/.venv/bin:$PATH"

COPY targets.json .

# The persistent model registry is initialized empty. Users can configure it
# during installation or later through CLI/Web Settings.
RUN printf '{"active_server":"","servers":{},"fallback_chain":[]}\n' > /app/servers.default.json
COPY docker/entrypoint.api.sh /usr/local/bin/orion-api-entrypoint
RUN chmod +x /usr/local/bin/orion-api-entrypoint
RUN useradd --create-home --shell /usr/sbin/nologin --uid 10001 orion \
    && mkdir -p /home/orion/.orion \
    && chown -R orion:orion /app /home/orion

EXPOSE 61888

USER orion

ENTRYPOINT ["orion-api-entrypoint"]
CMD ["uvicorn", "src.backend.api:app", "--host", "0.0.0.0", "--port", "61888"]
