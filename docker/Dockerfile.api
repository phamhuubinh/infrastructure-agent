FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    wait-for-it \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ src/
COPY config/ config/

RUN pip install --no-cache-dir -e ".[web]"

COPY targets.json .

# The persistent model registry is initialized empty. Users can configure it
# during installation or later through CLI/Web Settings.
RUN printf '{"active_server":"","servers":{},"fallback_chain":[]}\n' > /app/servers.default.json
COPY docker/entrypoint.api.sh /usr/local/bin/orion-api-entrypoint
RUN chmod +x /usr/local/bin/orion-api-entrypoint

EXPOSE 61888

ENTRYPOINT ["orion-api-entrypoint"]
CMD ["uvicorn", "src.backend.api:app", "--host", "0.0.0.0", "--port", "61888"]
