#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "Docker Engine with Docker Compose is required to run Orion." >&2
    exit 1
fi

cd "$PROJECT_DIR"

open_web_browser() {
    local web_url="$1"

    if [[ "${ORION_DISABLE_BROWSER:-}" == "1" ]]; then
        echo "Browser launch is disabled; open the URL above manually."
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        if command -v xdg-open >/dev/null 2>&1; then
            nohup xdg-open "$web_url" >/dev/null 2>&1 &
            echo "Opening the Web UI in your default browser..."
        elif command -v gio >/dev/null 2>&1; then
            nohup gio open "$web_url" >/dev/null 2>&1 &
            echo "Opening the Web UI in your default browser..."
        else
            echo "No desktop URL opener was found; open the URL above manually."
        fi
    else
        echo "No graphical desktop detected; open the URL above manually."
    fi
}

stop_web_stack() {
    local status=$?
    trap - EXIT INT TERM
    echo
    echo "Stopping Orion Web UI..."
    if ! docker compose stop reverse-proxy ui api; then
        echo "Warning: Orion Web UI did not stop cleanly." >&2
    fi
    exit "$status"
}

if [[ "${1:-}" == "web" ]]; then
    web_url="${ORION_WEB_URL:-http://localhost}"
    web_log_since="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "Starting Orion Web UI..."
    if ! docker compose up -d --no-build reverse-proxy; then
        echo "Unable to start Orion Web UI. Run: $PROJECT_DIR/install.sh" >&2
        exit 1
    fi

    echo "Orion Web UI: $web_url"
    open_web_browser "$web_url"
    echo "Showing current API/UI logs. Press Ctrl+C to stop the Web UI."

    trap 'exit 130' INT TERM
    trap stop_web_stack EXIT
    docker compose logs --follow --since "$web_log_since" ui api
    exit 0
fi

if [[ "${1:-}" == "log" ]]; then
    echo "Showing all Orion logs. Press Ctrl+C to return; Orion keeps running."
    exec docker compose logs --follow --tail=100
fi

if ! docker compose ps --status running --services 2>/dev/null | grep -qx api; then
    echo "Orion is not running. Start it with: orion web" >&2
    exit 1
fi

compose_args=(compose exec)
if [[ ! -t 0 || ! -t 1 ]]; then
    compose_args+=(-T)
fi

exec docker "${compose_args[@]}" api orion "$@"
