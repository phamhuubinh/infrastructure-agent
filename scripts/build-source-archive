#!/usr/bin/env bash
set -euo pipefail

output_dir="${1:-dist}"

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "Refusing to archive a dirty working tree." >&2
    exit 2
fi

revision="$(git rev-parse --verify --short=12 HEAD)"
archive_name="orion-${revision}-source.tar.gz"
archive_path="${output_dir}/${archive_name}"

if [[ -e "$archive_path" ]]; then
    echo "Archive already exists: $archive_path" >&2
    exit 2
fi

mkdir -p -- "$output_dir"
git archive --format=tar.gz --prefix="orion-${revision}/" --output="$archive_path" HEAD
echo "Source archive created: $archive_path"
