# `./install.sh` generates these secrets automatically. This file is for
# operators who intentionally run Docker Compose by hand.
POSTGRES_USER=orion
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=orion
ORION_API_KEY=replace-with-a-long-random-api-key
ORION_TOOL_SECRETS_FILE=/etc/orion/tool-credentials.json
